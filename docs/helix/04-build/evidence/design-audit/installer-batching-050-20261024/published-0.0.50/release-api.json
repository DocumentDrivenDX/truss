github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":6237543,"digest":"sha256:7b0483bb0c624c98515cf38ec30bbbf1ca43c1250e8880e5d00d520b4b7eec00","download_count":0,"created_at":"2026-10-24T06:32:47Z","updated_at":"2026-10-24T06:32:48Z","browser_download_url":"https://github.com/DocumentDrivenDX/truss/releases/download/v0.0.50/truss_toolkit-0.0.50-py3-none-any.whl"},{"url":"https://api.github.com/repos/DocumentDrivenDX/truss/releases/assets/671489712","id":671489712,"node_id":"RA_kwDOUoi0Ac4oBh6w","name":"truss_toolkit-0.0.50.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":6709423,"digest":"sha256:60204fbb2b420e4600ebafa397e2742b46f06d6085936411dfa81f19aa7c5aaa","download_count":0,"created_at":"2026-10-24T06:32:47Z","updated_at":"2026-10-24T06:32:48Z","browser_download_url":"https://github.com/DocumentDrivenDX/truss/releases/download/v0.0.50/truss_toolkit-0.0.50.tar.gz"}],"tarball_url":"https://api.github.com/repos/DocumentDrivenDX/truss/tarball/v0.0.50","zipball_url":"https://api.github.com/repos/DocumentDrivenDX/truss/zipball/v0.0.50","body":"\n# Truss v0.0.50\n\n## Release scope\n\nThe 0.0.50 candidate reduces synchronous database submissions during fresh\ninstallation. It targets the same PostgreSQL 18.6, psycopg 3.3.6, UMF 0.10 and\nWeft 0.4.51 cohort as [0.0.49](v0.0.49.md). Publication and exact installed\nqualification remain release gates in the\n[installer repair plan](../managed-platform-grants-plan.md#installer-round-trip-repair--2026-10-24).\n\n## Audience and channels\n\nPython embedders and database operators receive these notes with the immutable\nGitHub release assets. Existing applications retain their public interfaces.\n\n## Highlights and fixes\n\nFresh installation submits bounded batches of the original ordered SQL sources\nand exact object-specific ownership and privilege commands. Catalog dependency\nand effective-privilege verification use bounded set queries. Both verification\nphases, exact native object identities, managed-grantee policy, private defaults,\ncaller-owned transaction rollback and original operation deadlines remain required.\n\nCarrier counts measure client submissions. A captured source unit can contain\nmany PostgreSQL statements; fewer submissions do not mean fewer logical checks.\nNo VM, additional privilege or timeout increase is required by this change.\n\n## Required actions and migration\n\nInstall the checksum-verified released wheel and matching dependency cohort.\nOnly the latest application runtime is supported. Every admitted UMF 0.10\ndatabase lineage retains explicit forward migration to latest without an age\ncutoff; historical runtimes are migration inputs. Pre-0.10 sources remain\nunsupported. Startup never migrates or resets an existing database.\n\nThe candidate leaves native installation sources and published migration recipes\nunchanged. Its migration index archives the original 0.0.49 index and adds the\nchecksum-verified 0.0.49 wheel as an exact-current fixture. That tuple must pass\ncurrent verification without a fabricated migration edge or receipt. Older admitted native tuples use the existing explicit\noffline migration tooling and preservation/recovery procedure described in the\n[Python guide](../../../../packages/python/README.md).\n\n## Rollback and support\n\nInstallation failure rolls back to the original operation savepoint and preserves\nearlier caller work. A successful installation remains pending until the caller\nsettles the outer transaction. Do not retry uncertain settlement or downgrade an\nexisting database; retain the original recovery reference and reconcile it.\n\nActual Lakebase acceptance belongs to the separately frozen Arras WAN campaign,\nwhich must pass with its existing checks and operation deadlines. An optional\nregional runner comparison cannot satisfy or waive that gate.\nLocal PostgreSQL or hosted Linux results alone do not establish that managed\nservice claim. The existing protected-profile and managed-grantee boundaries\nremain as documented in 0.0.49.\n"}