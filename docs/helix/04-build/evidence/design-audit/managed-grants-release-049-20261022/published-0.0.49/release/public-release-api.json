ithub-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":6232642,"digest":"sha256:7ea14b2787f02cbeec9ad99d835adbcc30c684fd5be8e0765a1d8198b50e7182","download_count":0,"created_at":"2026-10-22T23:24:19Z","updated_at":"2026-10-22T23:24:19Z","browser_download_url":"https://github.com/DocumentDrivenDX/truss/releases/download/v0.0.49/truss_toolkit-0.0.49-py3-none-any.whl"},{"url":"https://api.github.com/repos/DocumentDrivenDX/truss/releases/assets/667379145","id":667379145,"node_id":"RA_kwDOUoi0Ac4nx2XJ","name":"truss_toolkit-0.0.49.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":6684486,"digest":"sha256:34ec940aa5ffac7466c1c73cd8cd330e82630d0901023cfe2cba3d353154570a","download_count":0,"created_at":"2026-10-22T23:24:19Z","updated_at":"2026-10-22T23:24:19Z","browser_download_url":"https://github.com/DocumentDrivenDX/truss/releases/download/v0.0.49/truss_toolkit-0.0.49.tar.gz"}],"tarball_url":"https://api.github.com/repos/DocumentDrivenDX/truss/tarball/v0.0.49","zipball_url":"https://api.github.com/repos/DocumentDrivenDX/truss/zipball/v0.0.49","body":"\n# Truss v0.0.49\n\n## Release scope\n\nThis release adds explicit managed platform grants for Python embedders and\noperators to the [v0.0.48 runtime](v0.0.48.md). The selected tuple is Python3.11+,\nPostgreSQL18.6, psycopg3.3.6, mini-racer0.14.1, UMF0.10 and Weft0.4.51 with its\nexact qualified compiler cohort. Release assets and the package guide are the\ndelivery channels. The macOS ARM64 campaign at commit `19d7bbe5` and hosted\nLinux campaign at commit `4188141f` pass on the same exact wheel and native\nmanifest below. Release completion requires the matching tag's mandatory Linux\ncampaign and independent public-download\nverification, as defined in the\n[managed grants plan](../managed-platform-grants-plan.md#v0049-release-execution--2026-10-22).\n\nThe native release label remains `truss-catalog-runtime/0.74-candidate`; the\nselected candidate manifest SHA-256 is\n`288801f7177338328441b5d3ce9328af31740ebf513f04ea45e30ae316a9f3a4`.\nThe preceding `35fd797b…` candidate has the exact local receipts described below;\nthey do not qualify this audit-accumulation target. Paired native captures\nand additive migration packaging are complete. The current native target has\ncomplete selected installed macOS ARM64 and branch Linux qualification below.\nExact manifest identity distinguishes these targets from v0.0.48's `c4339ac7…`\ntarget. A shared release label alone never establishes compatibility.\n\nThe selected Weft0.4.51 dependency is public. Its\n[asset and packaging verification](../evidence/design-audit/managed-grants-release-049-20261022/dependencies/public-weft-051/verification.json)\nbinds compiler source `55715373…` separately from its release tag/workflow\ncommit `d4b0b985…`.\nThe [public v0.0.48 input audit](../evidence/design-audit/managed-grants-release-049-20261022/dependencies/public-truss-048/verification.json)\nand [paired source48 admission](../evidence/design-audit/managed-grants-release-049-20261022/source48-admission/receipt.json)\nare also complete. The earlier native manifest `35fd797b…` macOS campaign passes for its exact\nrecorded artifacts. The current native target passes both selected installed\nmacOS ARM64 and hosted branch Linux campaigns below. The final tag campaign and\npublic verification are separate final release gates.\n\n## Highlights and fixes\n\n- Fresh installation accepts `tolerated_grantees`, a bounded tuple of exact\n  existing platform-role names. The default empty tuple preserves strict\n  installation. Selected grants and grant options remain in place; immutable\n  installation metadata records their native name/OID identities and initial\n  access-control-list (ACL) observations.\n- Subsequent administration verifies the stored identities. Initial ACL evidence\n  remains historical provenance; later grants to selected identities are allowed\n  within the explicit trusted platform boundary. Ordinary privileges, private\n  defaults, ownership and effective-access checks retain their exact requirements.\n- A contained `InstallRefused(code=\"third_party_grant\")` identifies the unlisted\n  role and safe object-class/phase context after confirmed operation rollback.\n  The local CLI prints the safe refusal as JSON and exits with status1. Prior\n  caller work survives; the caller still owns outer settlement.\n- Separately protected activation refuses a nonempty policy with\n  `unsupported_profile` before effects. Ordinary catalog registration, module\n  access, mutation, journal and feed workflows remain available within their\n  selected profile.\n- Strict preparation source verification accounts for ordered routine\n  replacements, exact overload signatures and the finite declared ACL profile.\n  It preserves declared public and registrar grants while refusing native drift.\n- Whole-group audit collection accumulates owners and entries in native arrays\n  before the existing JSON construction. This removes repeated JSON copying\n  while preserving order, duplicates, nulls, exact owner reduction, limits and\n  authorization. The original 10-second SQL and 30-second operation limits and\n  independent event budget remain unchanged.\n\nThe HF changes described in v0.0.48 remain part of the baseline; this release\nadds the managed policy and its integration fixes.\n\n## Required actions and migration\n\nOnly the latest runtime is supported. Startup never migrates an installation.\nOperators must quiesce writers, back up the database and host recovery registry,\nand follow the [migration guide](../../../../packages/python/README.md#runtime-migrations--v0049): inspect\nstatus, prepare and retain the reference, apply it, reconcile uncertain\nsettlement, and verify before resuming application work. Install the matching\nchecksum-verified Weft0.4.51 compiler cohort.\n\nThe required release lineage retains v0.0.44, shared v0.0.45/46 and v0.0.47 and\nnow includes the actual published v0.0.48 target. Its checksum-verified wheel\n`1aedf614…` supplies native manifest `c4339ac7…`; paired America/New_York and UTC captures\nadmitted its route to native manifest `35fd797b…`. The source profile, original migration\nmanifest `7d165e4a…` and all prior migration artifacts retain their exact bytes. The\ncurrent migration manifest is\n`96addcdb95523f478d8f50b0b47198e47a860680c7400dd359711930e837e535`.\nIt retains the preceding manifest `86bcf785…` and adds the representation-only audit\ncollector edge from manifest `35fd797b…` to `288801f7…`. All four complete routes and\nrecovery cases pass on the exact macOS ARM64 and hosted Linux artifacts below.\n\nForward migration installs an empty strict managed policy on existing admitted\ninstallations. It does not opt them into platform trust. Only fresh installation\nselects tolerated identities. Missing, renamed or recreated selected roles refuse;\nautomatic policy widening or role remapping is unavailable. Administrators must\nuse a separately reviewed recovery procedure for such drift.\n\n## Hold and recovery\n\nHold on native drift, failed verification or uncertain settlement. Reconcile\nthe original attempt without resubmitting effects. Pre-commit failure rolls back;\ncommitted changes require a forward fix or the qualified backup\nrestore/remigration route. Installing an old package is not database rollback.\n\n## Qualification and known limits\n\nThe [installed macOS ARM64 campaign](../evidence/design-audit/managed-grants-release-049-20261022/final-local-2888/qualification.json)\npasses on source `19d7bbe5793e61e4034769a18b1d9a03b5c7e959`, with Python3.11.17,\nPostgreSQL18.6, psycopg3.3.6 and the exact public Weft0.4.51 Mac cohort from\ncompiler source `557153731e9f5d0583193a1189a07c6ed485d3d3`. Its eight steps cover\nmodule boundaries and 20 allowed/forbidden controls, 21 managed modules/130 tests,\nHF62, nine strict protected tests, all 106 migration/recovery tests over four\nactual public source wheels, lifecycle controls and the original public workload.\nTest campaigns have zero skips, failures or errors. Lifecycle checks preserve\nthe initial carrier through supported additive evolution, contained unsupported\nrecord-retirement refusal and later selected ACL changes. The independent\nUMF commit `5ba77cff` / Bun1.4.3 oracle, all 1,206 frozen inputs, identities, installed payload and\nowned worker cleanup verify unchanged. The [retained-file index](../evidence/design-audit/managed-grants-release-049-20261022/final-local-2888/retained-files.json)\nbinds 53 original outputs retained losslessly.\n\nThe [complete hosted Linux branch campaign](../evidence/design-audit/managed-grants-release-049-20261022/linux-2888-branch/receipt.json)\npasses at source `4188141faf3e51a7a25711a6fc22751cb37c7ae4`, using the exact\npublic Weft0.4.51 Linux cohort from the same compiler source. It includes all\nmandatory branch installed regressions, the 21-module/130-test managed campaign,\nHF62 and the 106-case migration campaign,\nwith zero skips, failures or errors in those selected campaigns. Cleanup,\nunchanged-input/payload and pinned oracle controls pass. Its publish job is\nskipped because this is a branch qualification, rather than a release tag.\n\nBoth platforms use wheel\n`57fd9520a453dcafa52dabe6aa75a143c162593237e80177acaebdbd51202790`,\nnative manifest\n`288801f7177338328441b5d3ce9328af31740ebf513f04ea45e30ae316a9f3a4`\nand migration manifest\n`96addcdb95523f478d8f50b0b47198e47a860680c7400dd359711930e837e535`.\nAll 467 runtime payload files agree across source, wheel, sdist and installed\nMac package. The independent archive SHA-256 is\n`ae5726d745e6ce52f1229ad1d1b46ca6a5ff55d8cb0bb0aa73751f2dd8fd0eb6`;\nits corpus retains 62 cases, fixed limits and all 363 prior producer digests,\nadding two semantic controls as the 364th producer binding. Each platform's\npublic workload verifies 1,000 objects, 1,000 edges, 1,000 reads, 200 committed\nupdates and values after connection reopen, counting 26,122 SQL submissions.\nThese are selected workload observations; general latency budgets remain\nprovisional.\n\nThe [native capture and packaging receipt](../evidence/design-audit/managed-grants-release-049-20261022/audit-accumulation/receipt.json)\nrecords New York/UTC comparison and the additive manifest `35fd797b…` → `288801f7…` edge. All 21 prior\nmigration artifacts and original SQL retain their bytes. The private wheel with\nmanifest `35fd797b…` is an intermediate capture fixture, not an admitted public\nsource. The\n[bounded diagnostic](../evidence/design-audit/managed-grants-release-049-20261022/audit-diagnostic-39852375031/receipt.json)\nrecords the unchanged whole-group audit case on public48 and native manifest `288801f7…` without\nrelaxing assertions or deadlines. It is not a general performance certificate.\n\nEarlier failures remain unchanged: the [first Linux diagnostic](../evidence/design-audit/managed-grants-release-049-20261022/linux-attempt-1/receipt.json)\nrecords the corrected fault-injector issue; the [second diagnostic](../evidence/design-audit/managed-grants-release-049-20261022/linux-attempt-2/receipt.json)\nand [unchanged rerun](../evidence/design-audit/managed-grants-release-049-20261022/linux-attempt-3/receipt.json)\nretain the native manifest `35fd797b…` audit timeout. The [commit `6287e52a` macOS receipt](../evidence/design-audit/managed-grants-release-049-20261022/final-local/qualification.json)\nand [earlier managed-grants packet](../evidence/design-audit/managed-grants-20261022/README.md)\nremain historical candidate evidence; they are not reused to qualify native manifest `288801f7…`.\n\nExact branch wheel, sdist and corpus containers are retained privately and in\nGitHub artifacts subject to retention limits. Their durable hashes and payload\nmaps identify the tested bytes; they are not permanent public release assets.\nThe matching tag's [mandatory Linux campaign](../../../../.github/workflows/release.yml)\nand independent public verification bind the actual published assets separately.\nA release pass must join the final source, wheel, native manifest, compiler and\narchive; neither this branch pass nor the Mac pass claims publication.\n\nThe retained broad all-discovery diagnostic remains incomplete and unqualified.\nIt combines historical proof fixtures requiring removed row-home schemas and\nopt-in campaigns requiring older exact compiler bundles. It is outside the\ncurrent supported release campaign; scoped passes never turn it into a complete\nsuite pass. Historical failures remain available in the\n[original diagnostic](../evidence/design-audit/managed-grants-20261022/attempt-1/qualification.json).\n\nActual Lakebase service behavior, TLS/token handling and Arras adoption require\ntheir own exact consumer receipts. The local platform stand-in does not qualify\nthem. Nonempty-policy protected activation, protected-profile migration,\npre-UMF0.10 migration, downgrade and other drivers remain unsupported. Successful\nrecord/relationship retirement and broader performance targets are not added.\n"}