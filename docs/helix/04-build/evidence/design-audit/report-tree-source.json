                    {
                      "kind": "object",
                      "members": {
                        "DefElem": {
                          "kind": "object",
                          "members": {
                            "defname": {
                              "kind": "string",
                              "value": "as"
                            },
                            "arg": {
                              "kind": "object",
                              "members": {
                                "List": {
