{
  "identity": "truss-python-assembly-construction-diagnostic",
  "version": "0.1.0",
  "scope": "inert_reference_assembly_construction_only",
  "interfaceVersion": "truss-reference-assembly/0.1.0",
  "errorCodes": [
    "invalid_configuration",
    "unsupported_profile",
    "incompatible_selection"
  ],
  "pathGrammar": {
    "kind": "fixed_field_path",
    "allowed": [
      "interface_version",
      "assembly_id",
      "assembly_profile",
      "recovery",
      "database_identity",
      "schema",
      "capabilities",
      "host_services",
      "request_replay"
    ],
    "callerContentAllowed": false
  },
  "limits": {
    "capabilitySelections": 128,
    "textScalarCharacters": 1024,
    "textUtf8Bytes": 4096,
    "sha256AsciiCharacters": 64
  },
  "nativeAuthority": "none",
  "resourceQualification": "fixed_shape_count_and_text_bounds_only; no complete Python heap or elapsed-work claim"
}
