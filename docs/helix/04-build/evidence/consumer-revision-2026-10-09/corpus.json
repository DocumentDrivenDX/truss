  {
   "id": "freshness.replica-catches-up-to-a-token",
   "tags": [
    "replica"
   ],
   "covers": [
    "at-least",
    "position-and-lag"
   ],
   "description": "a replica has reached a receipt's token only once its feed carried the write",
   "fixture": "basic",
   "steps": [
    {
     "op": "authority_write",
     "as": "erik",
     "action": "catalog.AddUseCase",
     "inputs": {
      "code": "uc-9",
      "name": "N"
     },
     "expect": {
      "ok": "written"
     },
     "save": {
      "token": "t1"
     }
    },
    {
     "op": "reached",
     "token": "$t1",
     "expect": {
      "value": false
     }
    },
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT u.code FROM catalog.UseCase u WHERE u.code = 'uc-9'",
     "expect": {
      "rows": []
     }
    },
    {
     "op": "sync"
    },
    {
     "op": "reached",
     "token": "$t1",
     "expect": {
      "value": true
     }
    },
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT u.code FROM catalog.UseCase u WHERE u.code = 'uc-9'",
     "expect": {
      "rows": [
       {
        "code": "uc-9"
       }
      ]
     }
    }
   ]
  },
