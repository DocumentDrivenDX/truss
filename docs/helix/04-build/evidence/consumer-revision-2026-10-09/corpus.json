   "fixture": "basic",
   "steps": [
    {
     "op": "seed",
     "as": "erik",
     "records": [
      {
       "relationship": "addresses",
       "source": "sol-1",
       "target": "uc-2"
      }
     ]
    },
    {
     "op": "sync"
    },
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT s.code FROM catalog.Solution s WHERE s.addresses = 'uc-1' AND s.addresses = 'uc-2'",
     "requires": {
      "type": "catalog.Solution",
      "columns": [
       "code"
      ],
      "relationships": [
       "addresses"
      ]
     },
     "expect": {
      "rows": [
       {
        "code": "sol-1"
       }
      ]
     }
    },
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT s.code FROM catalog.Solution s WHERE s.addresses = 'uc-1' AND s.addresses = 'nope'",
     "requires": {
      "type": "catalog.Solution",
      "columns": [
       "code"
      ],
      "relationships": [
       "addresses"
      ]
     },
     "expect": {
      "rows": []
