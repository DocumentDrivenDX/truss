    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT u.code FROM catalog.UseCase u",
     "expect": {
      "error": "Unavailable",
      "reason": "unreachable"
     }
    },
    {
     "op": "outage",
     "reason": "access_denied"
    },
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT u.code FROM catalog.UseCase u",
     "expect": {
      "error": "Unavailable",
      "reason": "access_denied"
     }
    },
    {
     "op": "outage",
     "reason": null
    },
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT u.code FROM catalog.UseCase u",
     "expect": {
      "row_count": 2
     }
