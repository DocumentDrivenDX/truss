   "id": "read.count-group-by",
   "tags": [
    "authority",
    "replica"
   ],
   "covers": [
    "counts",
    "unsupported-capabilities"
   ],
   "description": "COUNT(*) grouped by one property, exact integers; a backend that does not declare count answers Unsupported",
   "fixture": "basic",
   "steps": [
    {
     "op": "seed",
     "as": "erik",
     "records": [
      {
       "type": "UseCase",
       "key": "uc-3",
       "properties": {
        "name": "NDA review"
       }
      }
     ]
    },
    {
     "op": "sync"
    },
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT u.name, COUNT(*) FROM catalog.UseCase u GROUP BY u.name",
     "requires": {
      "type": "catalog.UseCase",
      "columns": [
       "name"
      ],
      "count": true
     },
     "expect": {
      "rows": [
       {
        "name": "Lease abstraction",
        "count": 1
       },
       {
        "name": "NDA review",
        "count": 2
       }
      ]
     }
    }
   ]
