  {
   "id": "read.paging-by-key",
   "tags": [
    "authority",
    "replica"
   ],
   "covers": [
    "page-contract"
   ],
   "description": "pages are ordered by key; a cursor continues; the last page has none",
   "fixture": "basic",
   "steps": [
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT u.code FROM catalog.UseCase u",
     "limit": 1,
     "save": {
      "cursor": "c1"
     },
     "expect": {
      "rows": [
       {
        "code": "uc-1"
       }
      ],
      "next_cursor": true
     }
    },
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT u.code FROM catalog.UseCase u",
     "limit": 1,
     "after": "$c1",
     "expect": {
      "rows": [
       {
        "code": "uc-2"
       }
      ],
      "next_cursor": false
     }
    }
   ]
  },
  {
   "id": "read.relationship-columns-are-capped",
   "tags": [
    "authority",
    "replica"
   ],
   "covers": [
    "alias-star",
    "page-contract"
   ],
   "description": "alias.* returns at most 100 keys per relationship column and says it truncated",
   "fixture": "basic",
   "steps": [
    {
     "op": "seed_many",
     "as": "erik",
     "type": "Solution",
     "count": 101,
     "key": "m{:03}",
     "properties": {
      "name": "n"
     },
     "link": {
      "relationship": "addresses",
      "target": "uc-2"
     }
    },
    {
     "op": "sync"
    },
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT u.* FROM catalog.UseCase u WHERE u.code = 'uc-2'",
     "expect": {
      "truncated": true,
      "row_len": {
       "addressedBy": 100
      }
     }
    }
   ]
  },
