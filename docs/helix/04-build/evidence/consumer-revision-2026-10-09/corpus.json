 "cases": [
  {
   "id": "read.key-lookup-whole-entity",
   "tags": [
    "authority",
    "replica"
   ],
   "covers": [
    "key-lookups",
    "alias-star"
   ],
   "description": "alias.* by key returns every property, the relationship keys, the version and attribution",
   "fixture": "basic",
   "steps": [
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT u.* FROM catalog.UseCase u WHERE u.code = 'uc-1'",
     "expect": {
      "rows": [
       {
        "code": "uc-1",
        "name": "Lease abstraction",
        "practiceArea": "real-estate",
        "addressedBy": [
         "sol-1"
        ],
        "_version": 1,
        "_created_by": "erik",
        "_updated_by": "erik",
        "_original_author": null,
        "_original_at": null
       }
      ]
     }
    }
   ]
  },
