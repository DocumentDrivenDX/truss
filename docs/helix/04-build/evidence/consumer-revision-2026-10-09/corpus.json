        "_original_author": "ann",
        "_load_id": "L1"
       }
      ]
     }
    },
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT u.* FROM catalog.UseCase u WHERE u.code = 'uc-1'",
     "expect": {
      "rows": [
       {
        "name": "Lease abstraction",
        "_version": 1
       }
      ]
     }
    },
    {
     "op": "import",
