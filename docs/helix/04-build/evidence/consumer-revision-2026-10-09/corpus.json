   "id": "import.identity-skip-and-provenance",
   "tags": [
    "authority"
   ],
   "covers": [
    "import"
   ],
   "description": "an import creates what is new, skips what is held and leaves it alone, rejects what fails, and records the load",
   "fixture": "basic",
   "steps": [
    {
     "op": "import",
     "as": "erik",
     "load_id": "L1",
     "records": [
      {
       "type": "UseCase",
       "key": "uc-7",
       "properties": {
        "name": "Old"
       },
       "original_author": "ann",
       "original_at": null
      },
      {
       "type": "UseCase",
       "key": "uc-1",
       "properties": {
        "name": "overwritten?"
       }
      },
      {
       "type": "UseCase",
       "key": "uc-6",
       "properties": {}
      },
      {
       "relationship": "addresses",
       "source": "ghost",
       "target": "uc-7"
      }
     ],
     "expect": {
      "import": {
       "created": 1,
       "skipped": 1,
       "rejected": 2,
       "rejected_kinds": [
        "entity",
        "relationship"
       ]
      }
     }
    },
    {
     "op": "query",
     "as": "rita",
     "sql": "SELECT u.* FROM catalog.UseCase u WHERE u.code = 'uc-7'",
