{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:draft:import-input:0.1.0",
  "title": "Draft identity-first import envelope",
  "description": "Envelope shape only; payload bytes remain uninterpreted until eligible creation. Identity/source ownership, primary total key, registered profiles, exact artifacts and native resources require semantic admission.",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "const": "truss-import-input/0.1.0"
    },
    "layoutProfile": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
    },
    "importProfile": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
    },
    "valueProfile": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
    },
    "catalog": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "modelBundleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "revision",
        "modelBundleSha256"
      ],
      "additionalProperties": false
    },
    "loadId": {
      "type": "string",
      "minLength": 1
    },
    "assertedOrigin": {
      "$ref": "urn:truss:draft:exact-value:0.1.0#/$defs/value"
    },
    "records": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "object"
              },
              "identity": {
                "type": "object",
                "properties": {
                  "operation": {
                    "const": "object_key"
                  },
                  "type": {
                    "$ref": "urn:truss:draft:direct-cursor:0.1.0#/$defs/type"
                  },
                  "keyNumber": {
                    "type": "string",
                    "minLength": 1
                  },
                  "keyDefinitionPin": {
                    "type": "string",
                    "minLength": 1
                  },
                  "keyEncodingProfile": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
                  },
                  "components": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "propertyId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "definitionPin": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "$ref": "urn:truss:draft:exact-value:0.1.0#/$defs/value"
                        }
                      },
                      "required": [
                        "propertyId",
                        "definitionPin",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "operation",
                  "type",
                  "keyNumber",
                  "keyDefinitionPin",
                  "keyEncodingProfile",
                  "components"
                ],
                "additionalProperties": false
              },
              "payload": {
                "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
              },
              "payloadProfile": {
                "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
              }
            },
            "required": [
              "kind",
              "identity",
              "payload",
              "payloadProfile"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "edge"
              },
              "identity": {
                "type": "object",
                "properties": {
                  "relationshipDefinitionPin": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "$ref": "urn:truss:draft:history-record:0.1.0#/$defs/identity"
                  },
                  "target": {
                    "$ref": "urn:truss:draft:history-record:0.1.0#/$defs/identity"
                  }
                },
                "required": [
                  "relationshipDefinitionPin",
                  "source",
                  "target"
                ],
                "additionalProperties": false
              },
              "payload": {
                "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
              },
              "payloadProfile": {
                "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
              }
            },
            "required": [
              "kind",
              "identity",
              "payload",
              "payloadProfile"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "interfaceVersion",
    "layoutProfile",
    "importProfile",
    "valueProfile",
    "catalog",
    "loadId",
    "assertedOrigin",
    "records"
  ],
  "additionalProperties": false
}
