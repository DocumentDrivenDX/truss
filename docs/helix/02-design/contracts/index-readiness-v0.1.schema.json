{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:draft:index-readiness:0.1.0",
  "title": "Draft index readiness",
  "description": "Closed original job/attempt shape only. Actual installed inventory, original committed acceptance/current attempt custody and native observation require semantic admission. No performance or integrity guarantee.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "state": {
          "const": "declared"
        },
        "job": {
          "$ref": "#/$defs/job"
        }
      },
      "required": [
        "state",
        "job"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "queued",
            "building"
          ]
        },
        "attempt": {
          "$ref": "#/$defs/attempt"
        },
        "committedAcceptanceEvidenceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "state",
        "attempt",
        "committedAcceptanceEvidenceSha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "const": "ready"
        },
        "attempt": {
          "$ref": "#/$defs/attempt"
        },
        "observedAt": {
          "type": "string",
          "minLength": 1
        },
        "installedInventory": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
        },
        "verificationProfile": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
        }
      },
      "required": [
        "state",
        "attempt",
        "observedAt",
        "installedInventory",
        "verificationProfile"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "const": "failed"
        },
        "attempt": {
          "$ref": "#/$defs/attempt"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "outcomeEvidence": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
        },
        "physicalOutcome": {
          "enum": [
            "absent",
            "invalid_owned",
            "unknown"
          ]
        }
      },
      "required": [
        "state",
        "attempt",
        "code",
        "outcomeEvidence",
        "physicalOutcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "const": "stale"
        },
        "job": {
          "$ref": "#/$defs/job"
        },
        "reason": {
          "enum": [
            "installation",
            "catalog",
            "layout",
            "binding",
            "definition",
            "inventory"
          ]
        }
      },
      "required": [
        "state",
        "job",
        "reason"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "job": {
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "truss-index-job/0.1.0"
        },
        "installationId": {
          "type": "string",
          "minLength": 1
        },
        "acceptedCatalogRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "layoutProfile": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
        },
        "bindingProfile": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
        },
        "declarationIdentity": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
        },
        "target": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "relation": {
              "type": "string",
              "minLength": 1
            },
            "index": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "schema",
            "relation",
            "index"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "interfaceVersion",
        "installationId",
        "acceptedCatalogRevision",
        "layoutProfile",
        "bindingProfile",
        "declarationIdentity",
        "definition",
        "target"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "job": {
          "$ref": "#/$defs/job"
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "dispatcherProfile": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
        }
      },
      "required": [
        "job",
        "attemptId",
        "generation",
        "dispatcherProfile"
      ],
      "additionalProperties": false
    }
  }
}
