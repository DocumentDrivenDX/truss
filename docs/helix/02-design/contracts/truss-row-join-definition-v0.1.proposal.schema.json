  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:draft:row-join-definition:0.1.0",
  "title": "Proposed fixed row-home join definition",
  "description": "Closed selectors and original physical IDs; not SQL, an authority handle, or evidence of native join/integrity support.",
  "allOf": [
    {
      "if": {
        "properties": {
          "recordKind": {
            "const": "object"
          }
        }
      },
      "then": {
        "properties": {
          "ownerJoin": {
            "const": "object-id-and-type"
          },
          "owner": {
            "properties": {
              "relationName": {
                "const": "object"
              }
            },
            "type": "object"
          }
        },
        "not": {
          "required": [
            "edgeAssociationDefinition"
          ],
          "properties": {
            "edgeAssociationDefinition": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordKind": {
            "const": "edge"
          }
        }
      },
      "then": {
        "properties": {
          "ownerJoin": {
            "const": "edge-id-and-relationship"
          },
          "owner": {
            "properties": {
              "relationName": {
                "const": "edge"
              }
            },
            "type": "object"
          },
          "edgeAssociationDefinition": {}
        },
        "required": [
          "edgeAssociationDefinition"
        ]
      }
    }
  ]
