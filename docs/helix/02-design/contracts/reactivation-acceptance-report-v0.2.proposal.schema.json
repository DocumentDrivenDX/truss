{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:draft:reactivation-acceptance-report:0.2.0",
  "title": "Unadopted reactivation acceptance report alternative",
  "description": "Closed shape only. Signed native integer ranges, prior-retirement ordering, exact artifact bytes, original owner/lineage correspondence, complete transition membership and native lifecycle enforcement require independent semantic admission. Not an extension admitted by report 0.1.0.",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "const": "truss-acceptance-report/0.2.0"
    },
    "reportProfile": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/reportProfile"
    },
    "rev": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/rev"
    },
    "originalExecution": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/originalExecution"
    },
    "acceptedInput": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/acceptedInput"
    },
    "umf": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/umf"
    },
    "documents": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/documents"
    },
    "diagnostics": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/diagnostics"
    },
    "documentInterpretations": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/documentInterpretations"
    },
    "counts": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/counts"
    },
    "provisional": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/provisional"
    },
    "rebinds": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/rebinds"
    },
    "assertions": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/assertions"
    },
    "pending_indexes": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/pending_indexes"
    },
    "losses": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/losses"
    },
    "extensions": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/extensions"
    },
    "transformRegistrations": {
      "$ref": "urn:truss:draft:acceptance-report:0.1.0#/properties/transformRegistrations"
    },
    "lifecycleProfile": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
    },
    "reactivations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "identity": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "type"
                  },
                  "typeId": {
                    "type": "string",
                    "pattern": "^(0|-?[1-9][0-9]*)$",
                    "maxLength": 11
                  }
                },
                "required": [
                  "kind",
                  "typeId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "property"
                  },
                  "propertyId": {
                    "type": "string",
                    "pattern": "^(0|-?[1-9][0-9]*)$",
                    "maxLength": 11
                  }
                },
                "required": [
                  "kind",
                  "propertyId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "key"
                  },
                  "typeId": {
                    "type": "string",
                    "pattern": "^(0|-?[1-9][0-9]*)$",
                    "maxLength": 11
                  },
                  "keyNumber": {
                    "type": "string",
                    "pattern": "^(0|-?[1-9][0-9]*)$",
                    "maxLength": 6
                  }
                },
                "required": [
                  "kind",
                  "typeId",
                  "keyNumber"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "relationship"
                  },
                  "relationshipId": {
                    "type": "string",
                    "pattern": "^(0|-?[1-9][0-9]*)$",
                    "maxLength": 11
                  }
                },
                "required": [
                  "kind",
                  "relationshipId"
                ],
                "additionalProperties": false
              }
            ]
          },
          "owner": {
            "$ref": "urn:truss:draft:history-record:0.1.0#/$defs/owner"
          },
          "lineage": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
          },
          "beforeRetiredRevision": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "maxLength": 11
          },
          "beforeDefinition": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
          },
          "afterDefinition": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
          }
        },
        "required": [
          "identity",
          "owner",
          "lineage",
          "beforeRetiredRevision",
          "beforeDefinition",
          "afterDefinition"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "interfaceVersion",
    "reportProfile",
    "rev",
    "originalExecution",
    "acceptedInput",
    "umf",
    "documents",
    "diagnostics",
    "documentInterpretations",
    "counts",
    "provisional",
    "rebinds",
    "assertions",
    "pending_indexes",
    "losses",
    "extensions",
    "transformRegistrations",
    "lifecycleProfile",
    "reactivations"
  ],
  "additionalProperties": false
}
