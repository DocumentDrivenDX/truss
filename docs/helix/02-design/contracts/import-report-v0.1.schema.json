{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:draft:import-report:0.1.0",
  "title": "Draft import progress report",
  "description": "Shape only. Input/batch partition, derived counts, ordering, ownership/disposition compatibility, native identity, authorization and evidence trust require semantic validation.",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "const": "truss-import-report/0.1.0"
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "inputCount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "executedCatalogRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "importProfile": {
      "$ref": "#/$defs/profilePin"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution": {
      "enum": [
        "engine_owned",
        "host_adopted",
        "outer_engine_scope"
      ]
    },
    "status": {
      "enum": [
        "processed",
        "interrupted"
      ]
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "batches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/batch"
      }
    },
    "unprocessedIndices": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "createdCommitted": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "createdPending": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "createdRolledBack": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "createdCommitUnknown": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "createdTransactionUnresolved": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "attemptUnknown": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "skipped": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "rejected": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "unprocessed": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "createdCommitted",
        "createdPending",
        "createdRolledBack",
        "createdCommitUnknown",
        "createdTransactionUnresolved",
        "attemptUnknown",
        "skipped",
        "rejected",
        "unprocessed"
      ],
      "additionalProperties": false
    },
    "selectedConfiguration": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "keyReuse": {
          "enum": [
            "forbid",
            "allow"
          ]
        },
        "journalMode": {
          "enum": [
            "engine",
            "trigger"
          ]
        },
        "configurationProfile": {
          "$ref": "#/$defs/profilePin"
        },
        "installedProducerInventorySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceEpoch": {
          "type": "string",
          "minLength": 1
        },
        "installationId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "generation",
        "keyReuse",
        "journalMode",
        "configurationProfile",
        "installedProducerInventorySha256",
        "sourceEpoch",
        "installationId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "interfaceVersion",
    "attemptId",
    "inputCount",
    "executedCatalogRevision",
    "importProfile",
    "inputSha256",
    "execution",
    "status",
    "outcomes",
    "batches",
    "unprocessedIndices",
    "counts",
    "selectedConfiguration"
  ],
  "additionalProperties": false,
  "$defs": {
    "owner": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "moduleId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "documentId",
        "moduleId"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "typeId": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "maxLength": 20
        },
        "definitionPin": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "$ref": "#/$defs/owner"
        }
      },
      "required": [
        "id",
        "typeId",
        "definitionPin",
        "owner"
      ],
      "additionalProperties": false
    },
    "profilePin": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "identity",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "inputIndex": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "batchId": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "const": "created"
            },
            "identity": {
              "$ref": "#/$defs/identity"
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "required": [
            "inputIndex",
            "batchId",
            "outcome",
            "identity",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "inputIndex": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "batchId": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "const": "skipped"
            },
            "reason": {
              "enum": [
                "live_identity",
                "reserved_identity"
              ]
            },
            "identity": {
              "$ref": "#/$defs/identity"
            }
          },
          "required": [
            "inputIndex",
            "batchId",
            "outcome",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "inputIndex": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "batchId": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "const": "rejected"
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "inputIndex",
            "batchId",
            "outcome",
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "inputIndex": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "batchId": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "const": "attempt_unknown"
            },
            "recoveryReference": {
              "type": "string",
              "minLength": 1
            },
            "identity": {
              "$ref": "#/$defs/identity"
            }
          },
          "required": [
            "inputIndex",
            "batchId",
            "outcome",
            "recoveryReference"
          ],
          "additionalProperties": false
        }
      ]
    },
    "batch": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "batchId": {
              "type": "string",
              "minLength": 1
            },
            "inputIndices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            },
            "disposition": {
              "const": "committed"
            },
            "commitEvidenceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "batchId",
            "inputIndices",
            "disposition",
            "commitEvidenceSha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "batchId": {
              "type": "string",
              "minLength": 1
            },
            "inputIndices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            },
            "disposition": {
              "const": "pending"
            },
            "hostTransactionId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "batchId",
            "inputIndices",
            "disposition",
            "hostTransactionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "batchId": {
              "type": "string",
              "minLength": 1
            },
            "inputIndices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            },
            "disposition": {
              "const": "rolled_back"
            },
            "rollbackEvidenceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "batchId",
            "inputIndices",
            "disposition",
            "rollbackEvidenceSha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "batchId": {
              "type": "string",
              "minLength": 1
            },
            "inputIndices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            },
            "disposition": {
              "const": "commit_unknown"
            },
            "recoveryReference": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "batchId",
            "inputIndices",
            "disposition",
            "recoveryReference"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "batchId": {
              "type": "string",
              "minLength": 1
            },
            "inputIndices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            },
            "disposition": {
              "const": "transaction_unresolved"
            },
            "recoveryReference": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "batchId",
            "inputIndices",
            "disposition",
            "recoveryReference"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
