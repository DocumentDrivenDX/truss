{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:draft:catalog-view-request:0.1.0",
  "title": "Draft catalog view request",
  "description": "Shape only; owner uniqueness/authorization, supported profiles, selected revision and deployment budget maxima require semantic admission.",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "const": "truss-catalog-view-request/0.1.0"
    },
    "layoutProfile": {
      "$ref": "#/$defs/profilePin"
    },
    "viewProfile": {
      "$ref": "#/$defs/profilePin"
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "current"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "historical"
            },
            "catalogRevision": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          },
          "required": [
            "kind",
            "catalogRevision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "complete"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "authorized_projection"
            },
            "owners": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/owner"
              }
            }
          },
          "required": [
            "kind",
            "owners"
          ],
          "additionalProperties": false
        }
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "definitionCount": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "encodedBytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "required": [
        "definitionCount",
        "encodedBytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "interfaceVersion",
    "layoutProfile",
    "viewProfile",
    "selection",
    "scope",
    "limits"
  ],
  "additionalProperties": false,
  "$defs": {
    "owner": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "moduleId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "documentId",
        "moduleId"
      ],
      "additionalProperties": false
    },
    "profilePin": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "identity",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
