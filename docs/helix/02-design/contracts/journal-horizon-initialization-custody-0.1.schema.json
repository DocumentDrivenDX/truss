{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:journal-horizon-initialization-custody:0.1",
  "title": "Native journal horizon initialization custody",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "installationId",
    "runtimeManifestSha256",
    "initializerSha256",
    "installerSha256",
    "databaseOid",
    "ownerOid",
    "backendPid",
    "writerXid",
    "timeZone",
    "clockBeforeUtc",
    "clockAfterUtc",
    "candidateBoundPairs",
    "originalRelation"
  ],
  "properties": {
    "profile": {
      "const": "truss-journal-horizon-initialization/0.1"
    },
    "installationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "runtimeManifestSha256": {
      "$ref": "#/$defs/sha"
    },
    "initializerSha256": {
      "$ref": "#/$defs/sha"
    },
    "installerSha256": {
      "$ref": "#/$defs/sha"
    },
    "databaseOid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "ownerOid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "backendPid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "writerXid": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "timeZone": {
      "enum": [
        "UTC",
        "America/New_York"
      ]
    },
    "clockBeforeUtc": {
      "$ref": "#/$defs/instant"
    },
    "clockAfterUtc": {
      "$ref": "#/$defs/instant"
    },
    "candidateBoundPairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lowerUtc",
          "upperUtc"
        ],
        "properties": {
          "lowerUtc": {
            "$ref": "#/$defs/instant"
          },
          "upperUtc": {
            "$ref": "#/$defs/instant"
          }
        }
      }
    },
    "originalRelation": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [
        {
          "const": "journal_runtime_horizon"
        }
      ],
      "items": {
        "type": [
          "string",
          "boolean",
          "null"
        ]
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "$comment": "Shape only. Exact types, finite native instants, xid uint64 range, native custody, window derivation, complete candidates and profile-exact original relation checks are mandatory under truss.journal-horizon-initialization-custody."
}
