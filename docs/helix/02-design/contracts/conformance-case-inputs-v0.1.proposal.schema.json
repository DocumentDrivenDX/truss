{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:proposal:conformance-case-inputs:0.1.0",
  "title": "Proposed ordered language-neutral conformance inputs",
  "description": "Exact inputs for registered operations only. Registry meaning, unique labels, live scopes, aliases, resources and authority require independent semantic admission. Shape does not authorize execution.",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "const": "truss-conformance-case-inputs/0.1.0"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "registry": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
    },
    "grammarProfile": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "operationProfile": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
          },
          "input": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
          },
          "scope": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "none"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "owned",
                      "adopted",
                      "harness"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "label"
                ],
                "additionalProperties": false
              }
            ]
          },
          "observationProfile": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
          }
        },
        "required": [
          "label",
          "operation",
          "operationProfile",
          "input",
          "scope",
          "observationProfile"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "interfaceVersion",
    "caseId",
    "registry",
    "grammarProfile",
    "steps"
  ],
  "additionalProperties": false
}
