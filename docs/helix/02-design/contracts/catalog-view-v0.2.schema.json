{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:draft:catalog-view:0.2.0",
  "title": "Compact Truss catalog view",
  "description": "Shape only; ownership, native ranges, uniqueness, ordering, dependency closure, archive fidelity, inventory completeness and authorization require semantic admission.",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "const": "truss-catalog-view/0.2.0"
    },
    "catalogRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "layoutProfile": {
      "$ref": "#/$defs/profilePin"
    },
    "viewProfile": {
      "$ref": "#/$defs/profilePin"
    },
    "consistencyEvidenceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "inventorySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "extractionProfile": {
      "$ref": "#/$defs/profilePin"
    }
  },
  "required": [
    "interfaceVersion",
    "catalogRevision",
    "layoutProfile",
    "viewProfile",
    "consistencyEvidenceSha256",
    "scope",
    "definitions",
    "inventorySha256",
    "extractionProfile"
  ],
  "additionalProperties": false,
  "$defs": {
    "profilePin": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "identity",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "moduleId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "documentId",
        "moduleId"
      ],
      "additionalProperties": false
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "definitionPin": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "$ref": "#/$defs/owner"
            },
            "authoredIdentity": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "type"
            },
            "typeId": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            }
          },
          "required": [
            "definitionPin",
            "owner",
            "authoredIdentity",
            "kind",
            "typeId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "definitionPin": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "$ref": "#/$defs/owner"
            },
            "authoredIdentity": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "property"
            },
            "propertyId": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "typeId": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            }
          },
          "required": [
            "definitionPin",
            "owner",
            "authoredIdentity",
            "kind",
            "propertyId",
            "typeId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "definitionPin": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "$ref": "#/$defs/owner"
            },
            "authoredIdentity": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "key"
            },
            "typeId": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "keyNumber": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            }
          },
          "required": [
            "definitionPin",
            "owner",
            "authoredIdentity",
            "kind",
            "typeId",
            "keyNumber"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "definitionPin": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "$ref": "#/$defs/owner"
            },
            "authoredIdentity": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "relationship"
            },
            "relationshipId": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            }
          },
          "required": [
            "definitionPin",
            "owner",
            "authoredIdentity",
            "kind",
            "relationshipId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "entry": {
      "type": "object",
      "properties": {
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "lifecycle": {
          "enum": [
            "active",
            "retired"
          ]
        },
        "resolution": {
          "enum": [
            "defined",
            "provisional"
          ]
        },
        "definition": {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "sha256"
          ],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "acceptedCatalogRevision": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "documentOrdinal": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "documentRevision": {
              "type": "string",
              "minLength": 1
            },
            "acceptedDocumentSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "authoredPointer": {
              "type": "string"
            },
            "kind": {
              "const": "accepted_document"
            }
          },
          "required": [
            "acceptedCatalogRevision",
            "documentOrdinal",
            "documentRevision",
            "acceptedDocumentSha256",
            "authoredPointer",
            "kind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "reference",
        "lifecycle",
        "resolution",
        "definition",
        "dependencies",
        "provenance"
      ],
      "additionalProperties": false
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "complete"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "authorized_projection"
            },
            "authorizedScopeIdentity": {
              "type": "string",
              "minLength": 1
            },
            "closure": {
              "const": "complete_within_projection"
            }
          },
          "required": [
            "kind",
            "authorizedScopeIdentity",
            "closure"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
