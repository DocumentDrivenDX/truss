{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:draft:seed-baseline-inventory:0.2.0",
  "description": "Shape only; singleton binding, original transition/cut/order/archive completeness require admission.",
  "type": "object",
  "properties": {
    "attempt": {
      "$ref": "urn:truss:draft:seed-baseline-inventory:0.1.0#/properties/attempt"
    },
    "inventoryProfile": {
      "$ref": "urn:truss:draft:seed-baseline-inventory:0.1.0#/properties/inventoryProfile"
    },
    "baselineSha256": {
      "$ref": "urn:truss:draft:seed-baseline-inventory:0.1.0#/properties/baselineSha256"
    },
    "visibilityManifestSha256": {
      "$ref": "urn:truss:draft:seed-baseline-inventory:0.1.0#/properties/visibilityManifestSha256"
    },
    "extractionObservation": {
      "$ref": "urn:truss:draft:seed-baseline-inventory:0.1.0#/properties/extractionObservation"
    },
    "interfaceVersion": {
      "const": "truss-seed-baseline-inventory/0.2.0"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ordinal": {
            "$ref": "urn:truss:draft:seed-baseline-inventory:0.1.0#/properties/entries/items/properties/ordinal"
          },
          "identity": {
            "oneOf": [
              {
                "$ref": "urn:truss:draft:seed-baseline-inventory:0.1.0#/properties/entries/items/properties/identity"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "key_binding"
                  },
                  "sourceEpoch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "installationId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "sourceEpoch",
                  "installationId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "key_profile_transition"
                  },
                  "sourceEpoch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "installationId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "migrationAttemptId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "sourceEpoch",
                  "installationId",
                  "migrationAttemptId"
                ],
                "additionalProperties": false
              }
            ]
          },
          "payloadSha256": {
            "$ref": "urn:truss:draft:seed-baseline-inventory:0.1.0#/properties/entries/items/properties/payloadSha256"
          },
          "retainedOwnerEvidence": {
            "$ref": "urn:truss:draft:seed-baseline-inventory:0.1.0#/properties/entries/items/properties/retainedOwnerEvidence"
          }
        },
        "required": [
          "ordinal",
          "identity",
          "payloadSha256",
          "retainedOwnerEvidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "attempt",
    "inventoryProfile",
    "baselineSha256",
    "visibilityManifestSha256",
    "extractionObservation",
    "interfaceVersion",
    "entries"
  ],
  "additionalProperties": false
}
