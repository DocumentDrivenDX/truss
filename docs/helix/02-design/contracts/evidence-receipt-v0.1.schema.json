{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:draft:evidence-receipt:0.1.0",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "const": "truss-evidence/0.1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "procedure": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "workingRoot": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact",
        "command",
        "workingRoot"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pin"
      },
      "minItems": 1
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dimension",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "requiredCases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      },
      "minItems": 1,
      "maxItems": 100000
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome"
      },
      "minItems": 1,
      "maxItems": 100000
    },
    "observedAt": {
      "type": "string",
      "minLength": 1
    },
    "durationNanoseconds": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "trust": {
      "type": "object",
      "properties": {
        "runnerId": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 1
        }
      },
      "required": [
        "runnerId",
        "provenance"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "interfaceVersion",
    "runId",
    "procedure",
    "inputs",
    "environment",
    "requiredCases",
    "outcomes",
    "observedAt",
    "durationNanoseconds",
    "trust",
    "scope",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "reference",
        "sha256"
      ],
      "additionalProperties": false
    },
    "pin": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "identity",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "coverage"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "blocked",
            "not_run"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "status",
        "artifacts"
      ],
      "additionalProperties": false
    }
  }
}
