    },
    "identity": {
      "$ref": "urn:truss:draft:retained-history-archive:0.1.0#/properties/identity"
    },
    "baseline": {
      "$ref": "urn:truss:draft:retained-history-archive:0.1.0#/properties/baseline"
    },
    "throughVersion": {
