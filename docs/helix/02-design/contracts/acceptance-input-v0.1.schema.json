{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:acceptance-input:0.1.0",
  "title": "Proposed Truss complete acceptance input",
  "description": "Shape validation only. Duplicate JSON members, Unicode scalar validity, canonical base64, digest verification, document ordering/uniqueness, upstream validity, resource limits and authority require separate semantic validation.",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "const": "truss-acceptance-input/0.1.0"
    },
    "layoutProfile": {
      "$ref": "#/$defs/profilePin"
    },
    "acceptanceProfile": {
      "$ref": "#/$defs/profilePin"
    },
    "validatorProfile": {
      "$ref": "#/$defs/profilePin"
    },
    "supportProfile": {
      "$ref": "#/$defs/profilePin"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "transforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transform"
      }
    }
  },
  "required": [
    "interfaceVersion",
    "layoutProfile",
    "acceptanceProfile",
    "validatorProfile",
    "supportProfile",
    "documents",
    "binding",
    "policy",
    "transforms"
  ],
  "additionalProperties": false,
  "$defs": {
    "profilePin": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "identity",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "exactArtifact": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "bytesBase64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "identity",
        "bytesBase64",
        "sha256"
      ],
      "additionalProperties": false
    },
    "canonicalTree": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalTree"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/canonicalTree"
          }
        }
      ]
    },
    "ingress": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "native"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "converted"
            },
            "adapterProfile": {
              "$ref": "#/$defs/profilePin"
            },
            "source": {
              "$ref": "#/$defs/exactArtifact"
            },
            "lossReport": {
              "$ref": "#/$defs/exactArtifact"
            }
          },
          "required": [
            "kind",
            "adapterProfile",
            "source",
            "lossReport"
          ],
          "additionalProperties": false
        }
      ]
    },
    "document": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "documentRevision": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/exactArtifact"
        },
        "umfProfile": {
          "$ref": "#/$defs/profilePin"
        },
        "ingress": {
          "$ref": "#/$defs/ingress"
        }
      },
      "required": [
        "documentId",
        "documentRevision",
        "artifact",
        "umfProfile",
        "ingress"
      ],
      "additionalProperties": false
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "absent"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "present"
            },
            "vocabulary": {
              "$ref": "#/$defs/profilePin"
            },
            "artifact": {
              "$ref": "#/$defs/exactArtifact"
            }
          },
          "required": [
            "state",
            "vocabulary",
            "artifact"
          ],
          "additionalProperties": false
        }
      ]
    },
    "policy": {
      "type": "object",
      "properties": {
        "unknownEndpoint": {
          "enum": [
            "reject",
            "provisional",
            "skip"
          ]
        },
        "loss": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "profile": {
          "$ref": "#/$defs/profilePin"
        }
      },
      "required": [
        "unknownEndpoint",
        "loss",
        "profile"
      ],
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "properties": {
        "registration": {
          "$ref": "#/$defs/profilePin"
        },
        "targetDefinitionIdentity": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "$ref": "#/$defs/canonicalTree"
        }
      },
      "required": [
        "registration",
        "targetDefinitionIdentity",
        "parameters"
      ],
      "additionalProperties": false
    }
  }
}
