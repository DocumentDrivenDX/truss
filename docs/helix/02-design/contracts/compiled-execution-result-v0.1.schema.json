{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:draft:compiled-execution-result:0.1.0",
  "title": "Draft Truss compiled execution result",
  "description": "Host wrapper shape only; Weft owns nested artifact/decoder ABI. Exact digest, producer custody, current authority, obligations and native observation must independently correspond.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "executed"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bridgeProfile": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
        },
        "result": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
        },
        "observation": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
        }
      },
      "required": [
        "outcome",
        "artifactSha256",
        "bridgeProfile",
        "result",
        "observation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "refused"
        },
        "reason": {
          "enum": [
            "artifact",
            "profile",
            "provenance",
            "pins",
            "obligation",
            "authority",
            "resource"
          ]
        },
        "diagnosticProfile": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
        },
        "diagnostic": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
        }
      },
      "required": [
        "outcome",
        "reason",
        "diagnosticProfile",
        "diagnostic"
      ],
      "additionalProperties": false
    }
  ]
}
