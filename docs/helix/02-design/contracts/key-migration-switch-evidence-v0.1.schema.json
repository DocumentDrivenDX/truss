{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:draft:key-migration-switch-evidence:0.1.0",
  "description": "Original precommit switch shape only; native guards, generation arithmetic, complete actual effects and custody require semantic admission.",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "const": "truss-key-migration-switch-evidence/0.1.0"
    },
    "originalAttempt": {
      "$ref": "urn:truss:draft:key-migration-result:0.1.0#/$defs/attempt"
    },
    "procedure": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
    },
    "originalExclusion": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
    },
    "locatorCorrespondence": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
    },
    "guardEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespaceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "keySha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "original": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "existing"
                  },
                  "generation": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  }
                },
                "required": [
                  "state",
                  "generation"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "created"
                  }
                },
                "required": [
                  "state"
                ],
                "additionalProperties": false
              }
            ]
          },
          "deletions": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "insertions": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "resultingGeneration": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "actualEffectEvidence": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
          }
        },
        "required": [
          "namespaceSha256",
          "keySha256",
          "original",
          "deletions",
          "insertions",
          "resultingGeneration",
          "actualEffectEvidence"
        ],
        "additionalProperties": false
      }
    },
    "priorAdmission": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
    },
    "resultingAdmission": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
    },
    "installedInventory": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
    },
    "originalObservation": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
    },
    "completeEffectEvidence": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
    }
  },
  "required": [
    "interfaceVersion",
    "originalAttempt",
    "procedure",
    "originalExclusion",
    "locatorCorrespondence",
    "guardEffects",
    "priorAdmission",
    "resultingAdmission",
    "installedInventory",
    "originalObservation",
    "completeEffectEvidence"
  ],
  "additionalProperties": false
}
