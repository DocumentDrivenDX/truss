{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:proposal:conformance-operation-registry:0.1.0",
  "title": "Proposed complete conformance operation registry descriptor",
  "description": "Closed trusted-registration descriptor only. Original artifact custody, complete method/procedure semantics, selected capability availability, observer independence, actual scope/resource authority and case completeness require independent admission. Identity-path artifacts reference this registry; it does not reverse-reference their bytes.",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "const": "truss-conformance-operation-registry/0.1.0"
    },
    "registryProfile": {
      "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "operationProfile": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
          },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "registered_method"
                  },
                  "declaration": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "bindingProfile": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
                  }
                },
                "required": [
                  "kind",
                  "declaration",
                  "method",
                  "bindingProfile"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "registered_harness_procedure"
                  },
                  "procedure": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
                  },
                  "procedureProfile": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
                  }
                },
                "required": [
                  "kind",
                  "procedure",
                  "procedureProfile"
                ],
                "additionalProperties": false
              }
            ]
          },
          "callProcedure": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
          },
          "callProfile": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
          },
          "argumentSchema": {
            "type": "object",
            "properties": {
              "artifact": {
                "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
              },
              "pointer": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
              }
            },
            "required": [
              "artifact",
              "pointer"
            ],
            "additionalProperties": false
          },
          "resultSchema": {
            "type": "object",
            "properties": {
              "artifact": {
                "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
              },
              "pointer": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
              }
            },
            "required": [
              "artifact",
              "pointer"
            ],
            "additionalProperties": false
          },
          "scopeKinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "none",
                "owned",
                "adopted",
                "harness"
              ]
            }
          },
          "semanticContractInventory": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
          },
          "observers": {
            "type": "object",
            "properties": {
              "result": {
                "type": "object",
                "properties": {
                  "profile": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
                  },
                  "procedure": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
                  },
                  "independenceEvidence": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
                  }
                },
                "required": [
                  "profile",
                  "procedure",
                  "independenceEvidence"
                ],
                "additionalProperties": false
              },
              "state": {
                "type": "object",
                "properties": {
                  "profile": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
                  },
                  "procedure": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
                  },
                  "independenceEvidence": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
                  }
                },
                "required": [
                  "profile",
                  "procedure",
                  "independenceEvidence"
                ],
                "additionalProperties": false
              },
              "journal": {
                "type": "object",
                "properties": {
                  "profile": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
                  },
                  "procedure": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
                  },
                  "independenceEvidence": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
                  }
                },
                "required": [
                  "profile",
                  "procedure",
                  "independenceEvidence"
                ],
                "additionalProperties": false
              },
              "report": {
                "type": "object",
                "properties": {
                  "profile": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
                  },
                  "procedure": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
                  },
                  "independenceEvidence": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
                  }
                },
                "required": [
                  "profile",
                  "procedure",
                  "independenceEvidence"
                ],
                "additionalProperties": false
              },
              "performance": {
                "type": "object",
                "properties": {
                  "profile": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
                  },
                  "procedure": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
                  },
                  "independenceEvidence": {
                    "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
                  }
                },
                "required": [
                  "profile",
                  "procedure",
                  "independenceEvidence"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "result",
              "state",
              "journal",
              "report"
            ],
            "additionalProperties": false
          },
          "resourceProfile": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
          },
          "observationProfile": {
            "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
          }
        },
        "required": [
          "operation",
          "operationProfile",
          "target",
          "callProcedure",
          "callProfile",
          "argumentSchema",
          "resultSchema",
          "scopeKinds",
          "semanticContractInventory",
          "observers",
          "resourceProfile",
          "observationProfile"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "interfaceVersion",
    "registryProfile",
    "entries"
  ],
  "additionalProperties": false
}
