    "sql": {
      "type": "object",
      "properties": {
        "normative": {
          "const": false
        },
        "artifact": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
        }
      },
      "required": [
        "normative",
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "interfaceVersion",
    "caseId",
    "grammarProfile",
    "result",
    "state",
