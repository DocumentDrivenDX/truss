          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1
              },
              "boundary": {
                "enum": [
                  "pre_effect",
                  "pending",
                  "committed",
                  "rolled_back",
                  "unknown"
                ]
              },
              "comparatorProfile": {
                "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
              },
              "expected": {
                "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
              }
            },
            "required": [
              "step",
              "boundary",
              "comparatorProfile",
              "expected"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "observationProfile",
        "observations"
      ],
      "additionalProperties": false
    },
    "journal": {
      "type": "object",
      "properties": {
        "observationProfile": {
          "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1
              },
              "boundary": {
                "enum": [
                  "pre_effect",
                  "pending",
                  "committed",
                  "rolled_back",
                  "unknown"
                ]
              },
              "comparatorProfile": {
                "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/profilePin"
              },
              "expected": {
                "$ref": "urn:truss:acceptance-input:0.1.0#/$defs/exactArtifact"
              }
            },
            "required": [
              "step",
              "boundary",
              "comparatorProfile",
              "expected"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "observationProfile",
        "observations"
      ],
      "additionalProperties": false
    },
    "report": {
