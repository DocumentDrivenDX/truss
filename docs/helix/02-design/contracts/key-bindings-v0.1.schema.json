{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truss:draft:key-bindings:0.1.0",
  "title": "Draft Truss key bindings",
  "description": "Shape only; source/owner/component correspondence, profile availability, exact provenance, identity continuity and resources require semantic admission.",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "const": "truss-key-bindings/0.1.0"
    },
    "vocabularyProfile": {
      "$ref": "#/$defs/profilePin"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "bindingId": {
                "type": "string",
                "minLength": 1
              },
              "record": {
                "$ref": "#/$defs/record"
              },
              "kind": {
                "const": "portable_identity"
              },
              "authoredKeyId": {
                "type": "string",
                "minLength": 1
              },
              "tupleProfile": {
                "$ref": "#/$defs/profilePin"
              },
              "transportProfile": {
                "$ref": "#/$defs/profilePin"
              },
              "components": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/property"
                }
              }
            },
            "required": [
              "bindingId",
              "record",
              "kind",
              "authoredKeyId",
              "tupleProfile",
              "transportProfile",
              "components"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "bindingId": {
                "type": "string",
                "minLength": 1
              },
              "record": {
                "$ref": "#/$defs/record"
              },
              "kind": {
                "const": "storage_uniqueness"
              },
              "missingComponent": {
                "enum": [
                  "reject",
                  "omit_and_report"
                ]
              },
              "encodingProfile": {
                "$ref": "#/$defs/profilePin"
              },
              "components": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "property": {
                      "$ref": "#/$defs/property"
                    },
                    "equalityProfile": {
                      "$ref": "#/$defs/profilePin"
                    },
                    "nullPolicy": {
                      "enum": [
                        "reject",
                        "participating_null",
                        "nonparticipating"
                      ]
                    }
                  },
                  "required": [
                    "property",
                    "equalityProfile",
                    "nullPolicy"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "bindingId",
              "record",
              "kind",
              "missingComponent",
              "encodingProfile",
              "components"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "interfaceVersion",
    "vocabularyProfile",
    "bindings"
  ],
  "additionalProperties": false,
  "$defs": {
    "profilePin": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "identity",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "moduleId": {
          "type": "string",
          "minLength": 1
        },
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "definitionPin": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "documentId",
        "moduleId",
        "recordId",
        "definitionPin"
      ],
      "additionalProperties": false
    },
    "property": {
      "type": "object",
      "properties": {
        "authoredPropertyId": {
          "type": "string",
          "minLength": 1
        },
        "definitionPin": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "authoredPropertyId",
        "definitionPin"
      ],
      "additionalProperties": false
    }
  }
}
